diff --git a/server/src/middleware/auth.ts b/server/src/middleware/auth.ts
index d4d91a1..80db71a 100644
--- a/server/src/middleware/auth.ts
+++ b/server/src/middleware/auth.ts
@@ -27,7 +27,7 @@ const jwtSecret = JWT_SECRET || 'dev-secret-do-not-use-in-production';
 /**
  * Authentication middleware — validates JWT token
  */
-export function authenticate(req: Request, res: Response, next: NextFunction) {
+export async function authenticate(req: Request, res: Response, next: NextFunction) {
   const authHeader = req.headers.authorization;
   
   if (!authHeader || !authHeader.startsWith('Bearer ')) {
@@ -38,8 +38,25 @@ export function authenticate(req: Request, res: Response, next: NextFunction) {
 
   try {
     const decoded = jwt.verify(token, jwtSecret) as { userId: string; role: Role };
+
+    // The JWT only proves *identity* here — it is not trusted for the
+    // user's current role or active status. Those can change at any
+    // time (an admin promotes/demotes someone, or deactivates them),
+    // and a 7-day token must reflect that immediately, not after the
+    // token happens to expire. One extra indexed lookup per request
+    // is negligible at this app's scale and removes an entire class
+    // of "why does my role still say CUSTOMER" bugs.
+    const user = await prisma.user.findUnique({
+      where: { id: decoded.userId },
+      select: { role: true, isActive: true }
+    });
+
+    if (!user || !user.isActive) {
+      return res.status(401).json({ error: 'Hisob faol emas yoki topilmadi' });
+    }
+
     req.userId = decoded.userId;
-    req.userRole = decoded.role;
+    req.userRole = user.role;
     next();
   } catch (error) {
     return res.status(401).json({ error: 'Noto\'g\'ri yoki muddati tugagan token' });
